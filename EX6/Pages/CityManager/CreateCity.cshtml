@page
@model EX6.Pages.CityManager.CreateCityModel
@{
	ViewData["Title"] = "Cadastrar Cidade";
}

<h2>Cadastrar Cidade</h2>

<form method="post">

	<div class="mb-3">
		<label asp-for="Input.CityName" class="form-label">Nome da cidade:</label>
		<input asp-for="Input.CityName" class="form-control" />
		<span asp-validation-for="Input.CityName" class="text-danger"></span>

	</div>
	<button type="submit" class="btn btn-primary mt-2">Cadastrar</button>
</form>

@if (!string.IsNullOrWhiteSpace(Model.MsgSucesso))
{
	<div class="alert alert-success mt-3" role="alert">
		@Model.MsgSucesso
	</div>
}

@section Scripts {
	<partial name="_ValidationScriptsPartial" />
}
