@page
@model EXE10.Pages.CityManager.CreateCountryModel
@{
	ViewData["Title"] = "Criar País";
}

<h2>Cadastrar País</h2>

<form method="post">
	@for (int i = 0; i < 5; i++)
	{
		<div class="row mb-3">
			<div class="col-md-6">
				<label asp-for="Inputs[i].CountryName" class="form-label">Nome:</label>
				<input asp-for="Inputs[i].CountryName" class="form-control" />
				<span asp-validation-for="Inputs[i].CountryName" class="text-danger"></span>
			</div>
			<div class="col-md-4">
				<label asp-for="Inputs[i].CountryCode" class="form-label">Código:</label>
				<input asp-for="Inputs[i].CountryCode" class="form-control" />
				<span asp-validation-for="Inputs[i].CountryCode" class="text-danger"></span>
			</div>
		</div>
	}
	<button type="submit" class="btn btn-primary mt-2">Cadastrar</button>

</form>

@if (Model.CreatedCountries.Any())
{
	<div class="alert alert-success mt-3" role="alert">

		@foreach (var country in Model.CreatedCountries)
		{
			<p class="mb-1">País cadastrado com sucesso: @country.CountryName (Código: @country.CountryCode)</p>
		}
	</div>
}

@section Scripts {
	<partial name="_ValidationScriptsPartial" />
}