@page
@model EXE12.Pages.IndexModel
@{
	ViewData["Title"] = "Home page";
}

<h2 class="display-4">Gerenciador de Cidades Turísticas</h2>

<br />
<h4>Cidades Disponíveis</h4>

@if (Model.Cities.Any())
{
	<ul class="list-group">
		@foreach (var city in Model.Cities)
		{
			<li class="list-group-item">
				<a asp-page="/CityManager/CityDetails" asp-route-cityName="@city">@city</a>
			</li>
		}
	</ul>
}